{
  "name": "antechevents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AntechEvents — a mobile-first personal event command center.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "serve": "http-server -p 5173 -c-1 .",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "http-server": "^14.1.1",
    "tailwindcss": "^4.1.11"
  }
}
