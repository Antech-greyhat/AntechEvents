rules_version = '2';

// AntechEvents Firestore security rules.
// Every document is private to its authenticated owner. Client-side checks are a
// convenience only; these rules are the real authorization boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Incoming event payloads must belong to the caller and carry a usable title.
    function validEvent(data) {
      return data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200;
    }

    // User profile documents are keyed by uid.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Events are a top-level collection scoped by ownerId.
    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && validEvent(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && validEvent(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Availability records (busy periods, working hours) scoped by ownerId.
    match /availability/{docId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Shareable free/busy links. The document id is an unguessable capability
    // token: a non-revoked share is publicly readable by id, but the public
    // cannot LIST the collection, so links can't be enumerated. The stored
    // snapshot holds merged busy time ranges only — never event details.
    match /shares/{shareId} {
      // Reads the parent share once for the submissions subcollection below.
      function shareData() {
        return get(/databases/$(database)/documents/shares/$(shareId)).data;
      }

      allow get: if (resource != null && resource.data.revoked != true)
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Notes and meeting proposals left by (anonymous) visitors. Public create
      // is gated by the parent link's state, the matching capability flag, and
      // strict field/size validation. Only the owner can read or moderate them.
      match /submissions/{subId} {
        allow create: if shareData().revoked != true
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['note', 'proposal', 'request']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 160
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 1000
          && request.resource.data.keys().hasOnly(
               ['type', 'name', 'email', 'message', 'status', 'createdAt',
                'proposedStart', 'proposedEnd'])
          && (request.resource.data.type != 'note' || shareData().allowNotes == true)
          // Proposals and requests both need proposals enabled and valid times;
          // a request targets not-important (flexible) time, a proposal free time.
          && ((request.resource.data.type != 'proposal'
               && request.resource.data.type != 'request')
              || (shareData().allowProposals == true
                  && request.resource.data.proposedStart is timestamp
                  && request.resource.data.proposedEnd is timestamp));
        allow read, update, delete: if isSignedIn()
          && shareData().ownerId == request.auth.uid;
      }
    }
  }
}
